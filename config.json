{
    "display": {
        "fullscreen": false,
        "width": 1024,
        "height": 600,
        "fps": 60,
        "brightness": 100,
        "show_cursor": false
    },
    "clock": {
        "format_24h": true,
        "show_seconds": true,
        "blink_colon": true,
        "date_format": "%A, %B %d, %Y",
        "custom_message": "Raspberry Pi 3 \u2022 Smart Display",
        "show_message": false
    },
    "visual": {
        "theme": "cyberpunk",
        "animation": "matrix",
        "animation_speed": 1,
        "particle_count": 80,
        "glow_effect": true,
        "font_scale": 1
    },
    "web_remote": {
        "enabled": true,
        "port": 8080,
        "bind_address": "0.0.0.0"
    },
    "holiday": {
        "enabled": true,
        "country": "US",
        "show_upcoming": true,
        "custom_holidays": []
    },
    "background": {
        "enabled": true,
        "source": "cyber_city",
        "dimming": 55
    }
}